# ローカル開発用の環境変数サンプル。`wrangler dev` は `.env` を読み込む。
# 本番の値は wrangler.jsonc の [vars] と `wrangler secret put` で管理する。

# App
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:3030,http://localhost:3040

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@hal-cinema.example.jp

# Site
BASE_URL=http://localhost:3030
# Image server（ローカル開発時のみ）
IMAGE_BASE_URL=http://localhost:3090

# dev
TZ=Asia/Tokyo
