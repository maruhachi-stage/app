{
  "name": "back-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "db:setup": "npm run db:generate && npm run db:migrations:export && npm run db:migrations:local && npm run db:seed:local",
    "db:generate": "drizzle-kit generate",
    "db:migrations:export": "node scripts/export-d1-migrations.mjs",
    "db:migrations:local": "wrangler d1 migrations apply hal-cinema --local",
    "db:migrations:remote": "wrangler d1 migrations apply hal-cinema --remote",
    "db:seed:export": "node scripts/export-d1-seed.mjs",
    "db:seed:local": "wrangler d1 execute hal-cinema --local --file=d1/seed.sql",
    "db:seed:remote": "wrangler d1 execute hal-cinema --remote --file=d1/seed.sql",
    "db:bootstrap-staff": "tsx src/scripts/bootstrap-staff.ts",
    "images:upload": "node scripts/upload-images.mjs",
    "db:check": "drizzle-kit check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.15",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
