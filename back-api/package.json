{
  "name": "back-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:setup": "npm run db:up && npm run db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose -f docker-compose.yml up -d --no-recreate",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f mysql",
    "db:reset": "docker compose -f docker-compose.yml down -v",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/infrastructure/database/seed.ts",
    "db:migrate-and-seed": "npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:introspect": "drizzle-kit pull"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "mysql2": "^3.22.3",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
