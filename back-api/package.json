{
  "name": "back-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:up": "docker compose -f docker-compose.yml up -d --no-recreate",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f mysql",
    "db:reset": "docker compose -f docker-compose.yml down -v",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/infrastructure/database/seed.ts",
    "db:migrate-and-seed": "npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:introspect": "drizzle-kit pull",
    "staff:bootstrap": "tsx --env-file=.env src/scripts/bootstrap-staff.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "mysql2": "^3.22.3",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
