{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hal-cinema-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // ローカル開発時の待ち受けポート。front-web / staff-app の Vite proxy と SETUP.md の
  // 記述に揃えるため、`npm run dev` も `npm run dev:scheduled` もここで指定した 3080 を使う。
  "dev": {
    "port": 3080,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGIN": "https://hal-cinema-web.pages.dev,https://hal-cinema-staff.pages.dev",
    "RESEND_FROM_EMAIL": "no-reply@hal-cinema.example.jp",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hal-cinema",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "d1/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "hal-cinema-images",
    },
  ],
  "triggers": {
    "crons": ["0 15 * * *"],
  },
}
