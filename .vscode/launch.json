{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "front-web run",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}\\front-web"
    },
    {
      "name": "back-api run",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}\\back-api"
    },
    {
      "name": "staff-app run",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}\\staff-app"
    },
    {
      "name": "db:setup",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run db:setup",
      "cwd": "${workspaceFolder}\\back-api"
    },
    {
      "name": "db:reset",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run db:reset",
      "cwd": "${workspaceFolder}\\back-api"
    },
    {
      "name": "image-server run",
      "type": "node-terminal",
      "request": "launch",
      "command": "node server.js",
      "cwd": "${workspaceFolder}\\image-server"
    }
  ],
  "compounds": [
    {
      "name": "all dev",
      "configurations": [
        "db:setup",
        "back-api run",
        "front-web run",
        "staff-app run",
        "image-server run"
      ]
    }
  ]
}
